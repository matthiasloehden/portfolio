{
  "name": "matthias-loehden-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:host": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lighthouse": "yarn generate && yarn lhci autorun",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "documents:encrypt": "tsx --env-file=.env.documents scripts/encrypt-documents.ts",
    "type-check": "nuxi prepare && vue-tsc --build",
    "check": "yarn type-check && yarn lint && yarn format:check && yarn test:unit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@nuxtjs/i18n": "^10.6.0",
    "age-encryption": "^0.3.1",
    "nuxt": "^4.5.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
